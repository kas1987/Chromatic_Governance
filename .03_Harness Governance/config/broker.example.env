# Copy to .env locally. Do not commit real values.
GITHUB_APP_ID=replace_me
GITHUB_APP_PRIVATE_KEY_PATH=/secure/path/to/private-key.pem
GITHUB_API_VERSION=2026-03-10
BROKER_AUDIT_LOG=logs/access_events.jsonl
BROKER_DRY_RUN=true

# Optional: external provider keys for cross-provider routing.
# Leave blank if you want local-only operation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Ollama wiring (no key required by default).
# Local laptop endpoint.
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434
# Optional remote desktop endpoint.
OLLAMA_REMOTE_BASE_URL=http://desktop.local:11434
# Default model choices for local routing.
OLLAMA_MODEL_C1=llama3.2:3b
OLLAMA_MODEL_C2=qwen2.5-coder:14b
