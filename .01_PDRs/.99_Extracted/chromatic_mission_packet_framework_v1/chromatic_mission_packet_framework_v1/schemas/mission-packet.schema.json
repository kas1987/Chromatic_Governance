{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromatic.local/schemas/mission-packet.schema.json",
  "title": "Chromatic Harness Mission Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "mission_level",
    "title",
    "objective",
    "owner_agent",
    "status",
    "complexity",
    "privacy_class",
    "scope",
    "allowed_actions",
    "blocked_actions",
    "acceptance_criteria",
    "validation",
    "stop_conditions",
    "governance"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "mission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,120}$"},
    "mission_level": {"type": "string", "enum": ["M1", "M2", "M3", "M4"]},
    "title": {"type": "string", "minLength": 5},
    "objective": {"type": "string", "minLength": 10},
    "background": {"type": "string"},
    "owner_agent": {"type": "string", "enum": ["sentinel", "auditor", "chainbreaker", "quartermaster", "cartographer", "financier", "archivist", "janitor", "local_worker", "human"]},
    "support_agents": {"type": "array", "items": {"type": "string"}, "default": []},
    "status": {"type": "string", "enum": ["draft", "ready", "blocked", "in-progress", "review-required", "done", "failed"]},
    "complexity": {"type": "string", "enum": ["C1", "C2", "C3", "C4"]},
    "privacy_class": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope", "allowed_files", "forbidden_files"],
      "properties": {
        "in_scope": {"type": "array", "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}},
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "forbidden_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "blocked_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "steps": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks", "success_definition"],
      "properties": {
        "required_checks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "optional_checks": {"type": "array", "items": {"type": "string"}},
        "success_definition": {"type": "string", "minLength": 5},
        "evidence_required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "strategy": {"type": "string"},
        "trigger": {"type": "string"},
        "owner": {"type": "string"}
      }
    },
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "gates", "approval_required"],
      "properties": {
        "level": {"type": "string", "enum": ["standard", "elevated", "high", "maximum"]},
        "gates": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "approval_required": {"type": "boolean"},
        "reviewers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pdr_ref": {"type": ["string", "null"]},
    "supporting_docs": {"type": "array", "items": {"type": "string"}},
    "created_by": {"type": "string"},
    "created_at": {"type": "string"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"mission_level": {"const": "M1"}}},
      "then": {
        "properties": {
          "complexity": {"enum": ["C1", "C2"]},
          "risk_level": {"enum": ["low", "medium"]}
        }
      }
    },
    {
      "if": {"properties": {"mission_level": {"const": "M4"}}},
      "then": {
        "required": ["pdr_ref", "rollback", "supporting_docs"],
        "properties": {
          "governance": {
            "properties": {
              "level": {"const": "maximum"},
              "approval_required": {"const": true}
            }
          }
        }
      }
    }
  ]
}
