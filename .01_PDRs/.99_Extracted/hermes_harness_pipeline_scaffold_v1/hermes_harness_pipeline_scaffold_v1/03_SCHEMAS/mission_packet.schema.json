{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chromatic Mission Packet",
  "type": "object",
  "required": [
    "mission_id",
    "title",
    "objective",
    "complexity",
    "privacy_class",
    "risk_class",
    "allowed_files",
    "forbidden_files",
    "acceptance_criteria",
    "validation_commands",
    "stop_conditions",
    "expected_output"
  ],
  "properties": {
    "mission_id": {"type": "string"},
    "title": {"type": "string"},
    "objective": {"type": "string"},
    "complexity": {"enum": ["C1", "C2", "C3", "C4"]},
    "privacy_class": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "preferred_model": {"type": "string"},
    "allowed_files": {"type": "array", "items": {"type": "string"}},
    "forbidden_files": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "validation_commands": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "expected_output": {"type": "string"},
    "escalation_target": {"type": "string"}
  },
  "additionalProperties": false
}
